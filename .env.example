# CricImpact — Environment Configuration Template
# Copy this file to .env and configure the appropriate values for your environment.

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# CORS Configuration (comma-separated origins allowed to access the backend API)
# In development, defaults to localhost:5173, 127.0.0.1:5173, localhost:3000, 127.0.0.1:3000
# In production (ENVIRONMENT=production), must be explicitly set to your frontend domain(s)
# (e.g. https://cricimpact.vercel.app). Never combine with wildcard (*) if credentials are used.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Cricket Data Live Providers (for live API integration)
CRICKETDATA_API_KEY=your_cricketdata_api_key_here
CRICKETLIVEAPI_KEY=your_cricketlive_api_key_here

# Frontend API Configuration (for standalone / deployed frontend builds)
# Set to remote backend URL if deployed separately (e.g. https://cricimpact.onrender.com or https://cricimpact.onrender.com/api).
# The frontend client automatically normalizes origins to guarantee the '/api' prefix.
# Leave as /api or unset when using local Vite proxy or same-origin deployment.
VITE_API_BASE_URL=/api

