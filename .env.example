# CricImpact — Environment Configuration Template
# Copy this file to .env and configure the appropriate values for your environment.

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Optional Cricket Data Live Providers (for live API integration)
CRICKETDATA_API_KEY=your_cricketdata_api_key_here
CRICKETLIVEAPI_KEY=your_cricketlive_api_key_here

# Frontend API Configuration (for standalone / deployed frontend builds)
# Set to remote API URL if deployed separately (e.g. https://api.cricimpact.com)
# Leave as /api when using local Vite proxy or same-origin deployment
VITE_API_BASE_URL=/api
